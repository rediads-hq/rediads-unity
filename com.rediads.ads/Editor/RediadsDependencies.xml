<?xml version="1.0" encoding="utf-8"?>
<!--
  Native Rediads SDKs, resolved by the External Dependency Manager (com.unity.external-dependency-manager):
  the Android SDK from Maven Central, the iOS pods from Rediads' pod list in github.com/rediads-hq/rediads-ios
  (its Specs/ folder; CocoaPods trunk is read-only). scripts/build_release.sh reads the versions here and
  compiles the bridges against them.
-->
<dependencies>
  <androidPackages>
    <androidPackage spec="com.rediads:rediads-display:0.1.0-beta1">
      <repositories>
        <repository>https://repo.maven.apache.org/maven2</repository>
      </repositories>
    </androidPackage>
  </androidPackages>
  <iosPods>
    <iosPod name="RediadsEngine" version="0.1.3">
      <sources>
        <source>https://github.com/rediads-hq/rediads-ios.git</source>
        <source>https://cdn.cocoapods.org/</source>
      </sources>
    </iosPod>
    <iosPod name="RediadsCore" version="0.1.3" />
    <iosPod name="RediadsDisplay" version="0.1.3" />
    <!-- Viewability measurement (Open Measurement), found by the SDK at run time. Its framework is
         dynamic, and CocoaPods embeds dynamic frameworks only for app targets, so this pod goes to
         Unity-iPhone as well as UnityFramework. -->
    <iosPod name="RediadsOM" version="0.1.3" addToAllTargets="true" />
  </iosPods>
</dependencies>
